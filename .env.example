# Banco de dados PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/trackscale"

# NextAuth — gere com: openssl rand -base64 32
AUTH_SECRET="SUBSTITUA_POR_STRING_ALEATORIA_DE_32_CHARS"

# Criptografia AES-256-GCM para tokens do Spotify
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY="SUBSTITUA_POR_64_CHARS_HEX"

# Spotify OAuth
SPOTIFY_CLIENT_ID="seu_spotify_client_id"
SPOTIFY_CLIENT_SECRET="seu_spotify_client_secret"
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/auth/spotify/callback"

# URL base da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Segredo enviado no header Authorization: Bearer para o cron de snapshots do Spotify
CRON_SECRET="SUBSTITUA_POR_UMA_STRING_ALEATORIA"

# Meta Conversions API (server-side)
# Token de System User do Business Manager — nunca o token da conta pessoal
META_CAPI_ACCESS_TOKEN="EAAxxxxxxxxxxxxx"
# Pixel padrão para eventos sem pixel específico de link (opcional)
META_CAPI_DEFAULT_PIXEL_ID=""
# Código de teste do Events Manager do Meta (deixe vazio em produção)
META_CAPI_TEST_EVENT_CODE=""

# Odesli / song.link API key — necessário para resolver URLs cross-platform
# Registe-se em: https://odesli.co/contact (plano gratuito disponível)
ODESLI_API_KEY=""
